# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Payaza (server-only, NEVER NEXT_PUBLIC_ except the merchant key) ---
# Raw public key (PZ78-PKTEST-…); base64-encoded in lib/payaza/headers.ts
PAYAZA_PUBLIC_KEY=
# Secret key — webhook HMAC-SHA512 verification
PAYAZA_SECRET_KEY=
# test | live
PAYAZA_TENANT=test
PAYAZA_PRODUCT_ID=app
PAYAZA_BASE_URL=https://api.payaza.africa/live
# Checkout SDK connection_mode: Test | Live
PAYAZA_CHECKOUT_MODE=Test
# Live only — 6-digit payout PIN (no repeated/sequential digits)
PAYAZA_PAYOUT_PIN=
# Raw public key for the client Checkout SDK (public by design; TEST key only)
NEXT_PUBLIC_PAYAZA_MERCHANT_KEY=

# --- TypeSafe Jev (server-only) ---
TYPESAFE_API_KEY=
TYPESAFE_MODEL=

# --- DB ---
# Empty → embedded PGlite at ./data/pglite (dev/Demo Mode).
# Set → postgres-js driver (Neon pooled connection string recommended).
DATABASE_URL=

# --- Auth ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Notifications (all optional; stubbed in Demo Mode) ---
RESEND_API_KEY=
AFRICASTALKING_USER=
AFRICASTALKING_KEY=

# --- Demo Mode ---
# true → fixtures + webhook replay; Payaza/Jev calls stubbed with recorded payloads.
# Auto-enabled server-side when PAYAZA_PUBLIC_KEY is empty (lib/config/env.ts).
NEXT_PUBLIC_DEMO_MODE=true
DEMO_SEED=wanjiru
